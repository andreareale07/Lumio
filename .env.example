# Copia questo file in `.env` e personalizza i valori.
# Non committare mai il file `.env` reale (contiene secret).

# --- Branding (mai hardcoded nel codice) ---
APP_NAME=Lumio
APP_TAGLINE=See your money clearly.
# Duplicati con prefisso VITE_: Vite espone al client solo le variabili con questo
# prefisso, quindi il branding usato dal frontend deve passare di qui.
VITE_APP_NAME=Lumio
VITE_APP_TAGLINE=See your money clearly.

# --- Ambiente ---
APP_ENV=development

# --- Database ---
# Modalità standard (Postgres nel compose). ATTENZIONE: deve usare il ruolo
# applicativo (POSTGRES_APP_USER sotto), MAI il ruolo bootstrap/superuser —
# quest'ultimo bypassa sempre la Row-Level Security, rendendola inutile.
DATABASE_URL=postgresql+asyncpg://lumio_app:lumio_app_password@postgres:5432/lumio
# Modalità power user (Postgres esterno): l'utente deve essere un ruolo
# dedicato, NOSUPERUSER e NOBYPASSRLS, creato appositamente sul Postgres
# esterno (vedi README, sezione "Modalità power user"). Esempio:
# DATABASE_URL=postgresql+asyncpg://lumio_app:password@192.168.1.20:5432/lumio

# --- Redis ---
REDIS_URL=redis://redis:6379/0
# Consigliato (opzionale): password di Redis. Imposta REDIS_PASSWORD e, con la
# STESSA password, REDIS_URL=redis://:<password>@redis:6379/0 (caratteri speciali
# nella password: usa solo lettere e cifre, o codificali come %XX nell'URL).
# Poi: docker compose up -d (ricrea redis, app e worker).
# REDIS_PASSWORD=

# --- Sicurezza ---
# Genera un valore casuale forte, es: python -c "import secrets; print(secrets.token_urlsafe(64))"
# Con APP_ENV=production l'app NON PARTE se e' sotto i 32 caratteri o e' il
# valore di esempio. Da qui si derivano la firma dei token e la chiave che cifra
# le chiavi bancarie e le API key nel DB: cambiarlo dopo il primo avvio le rende
# illeggibili (vanno rigenerate), quindi conservalo come il backup del database.
SECRET_KEY=change-me-to-a-long-random-value
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=30

# --- Storage locale file privati (import PDF, ecc.) ---
STORAGE_PATH=/app/storage

# --- Import Engine ---
# Limite dimensione file caricato (bytes). Applicato in streaming durante
# l'upload, non dopo aver letto tutto il file (SPEC §53).
MAX_IMPORT_FILE_SIZE_BYTES=10485760
# Timeout massimo (secondi) del job worker che processa un import.
IMPORT_JOB_TIMEOUT_SECONDS=300
# TTL (secondi) dello stream Redis con gli eventi di progresso di un import.
JOB_EVENTS_TTL_SECONDS=86400

# --- AI (opzionale, l'app deve funzionare al 100% senza nessun profilo
# AI configurato) --- si configura per workspace dalla UI (/settings/ai),
# nessuna variabile d'ambiente per il provider: vedi ai_profiles nel DB.

# --- Integrazioni opzionali ---
GOOGLE_ENABLED=false
# Per abilitare Google Sheets (milestone 10) serve un progetto Google Cloud:
# 1. Crea un progetto su https://console.cloud.google.com
# 2. Abilita "Google Sheets API" e "Google Drive API"
# 3. Configura la OAuth consent screen (puo' restare in modalita' "Testing")
# 4. Crea credenziali OAuth client ID (tipo "Web application"), registrando
#    GOOGLE_REDIRECT_URI come redirect URI autorizzato
# 5. Crea una API key separata (Browser key), ristretta alla "Google Picker
#    API" — serve solo al widget di selezione cartella lato frontend, non
#    e' il client OAuth
# Questi valori sono secret di ISTANZA (un solo Google Cloud client per
# l'intera installazione self-hosted), mai per-workspace.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Punta alla porta del FRONTEND (proxata da nginx su /api/, vedi
# frontend/nginx.conf), non a quella del backend: il redirect finale dopo
# il callback e' un path relativo, deve risolvere sull'origine su cui
# l'utente sta navigando (quella del frontend), non su quella del backend.
GOOGLE_REDIRECT_URI=http://localhost:5173/api/v1/integrations/google/callback
GOOGLE_PICKER_API_KEY=
# Duplicato con prefisso VITE_ (vedi nota branding sopra): il widget Google
# Picker gira nel browser, quindi la Browser key deve arrivare al frontend.
VITE_GOOGLE_PICKER_API_KEY=

# --- Open Banking (opzionale: importa i movimenti dalla banca) ---
# Con OPEN_BANKING_ENABLED=false (default) l'app funziona al 100% con import
# PDF/CSV e questi endpoint non esistono. Nessuna credenziale qui: l'application
# ID e la chiave sono PER UTENTE (i Terms di Enable Banking permettono l'uso
# gratuito solo per conti personali propri) e si configurano dall'app in
# Impostazioni > Conti bancari collegati. Guida: docs/open-banking-setup.md
OPEN_BANKING_ENABLED=false
# Indirizzo PUBBLICO in HTTPS del callback, identico a quello registrato nel
# Control Panel di Enable Banking (stesso dominio da cui usi Lumio).
OPEN_BANKING_REDIRECT_URI=https://lumio.example.org/api/v1/open-banking/callback
# Opzionali. Intervallo minimo tra due sync automatiche della stessa banca
# (minimo 6 ore: molte banche limitano a 4 letture al giorno in background) e
# giorni riletti a ogni sync per recepire contabilizzazioni tardive.
# OPEN_BANKING_SYNC_INTERVAL_HOURS=8
# OPEN_BANKING_RECONCILE_DAYS=7

# --- App mobile (opzionale) ---
# Origin ammesse per il CORS dell'app Android/iOS (Capacitor). L'app usa solo
# Bearer, nessun cookie: i default vanno bene, cambiali solo se serve.
# MOBILE_APP_ORIGINS=http://localhost,https://localhost,capacitor://localhost
# Notifiche push (Firebase Cloud Messaging): percorso DENTRO il container del file
# JSON del service account (mai nel repo). Vuoto = push spento. Guida: docs/mobile-app.md
# FCM_SERVICE_ACCOUNT_FILE=/run/secrets/fcm.json

# --- Porte esposte in locale ---
BACKEND_PORT=8000
FRONTEND_PORT=5173
# Solo override di produzione: indirizzo su cui ascolta il frontend. Il default
# 127.0.0.1 vale se il reverse proxy e' sulla stessa macchina; con proxy su un
# altro host/LXC usa 0.0.0.0 e limita la porta via firewall.
# FRONTEND_BIND=127.0.0.1

# --- Postgres (solo modalità standard, container incluso) ---

# Ruolo bootstrap: creato dall'immagine Docker ufficiale, e' SEMPRE superuser.
# Usato solo internamente per inizializzare il DB (docker-entrypoint-initdb.d)
# e per accesso amministrativo occasionale. L'app non deve mai connettersi con
# questo ruolo.
POSTGRES_SUPERUSER=lumio_admin
POSTGRES_SUPERUSER_PASSWORD=change-me-superuser-password
POSTGRES_DB=lumio

# Ruolo applicativo: creato da db/postgres-init/01-create-app-role.sh come
# NOSUPERUSER NOBYPASSRLS. E' quello che DATABASE_URL deve usare, sopra.
POSTGRES_APP_USER=lumio_app
POSTGRES_APP_PASSWORD=lumio_app_password
